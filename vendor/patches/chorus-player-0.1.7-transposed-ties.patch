+import { XMLBuilder, XMLParser } from 'fast-xml-parser';
+
+type Node = Record<string, unknown>;
+const options = { ignoreAttributes: false, preserveOrder: true, parseTagValue: false, parseAttributeValue: false };
+const parser = new XMLParser(options);
+const builder = new XMLBuilder({ ...options, suppressEmptyNode: true });
+const tag = (node: Node) => Object.keys(node).find(key => key !== ':@') ?? '';
+const children = (node: Node, name: string): Node[] => Array.isArray(node[name]) ? node[name] as Node[] : [];
+const attributes = (node: Node): Record<string, string> => (node[':@'] ?? {}) as Record<string, string>;
+const text = (nodes: Node[], name: string): string => {
+  const element = nodes.find(node => tag(node) === name);
+  return element ? children(element, name).map(node => node['#text'] ?? '').join('') : '';
+};
+const descendants = (nodes: Node[], name: string): Node[] => nodes.flatMap(node =>
+  tag(node) === name ? [node] : Object.entries(node).filter(([key, value]) => key !== ':@' && Array.isArray(value)).flatMap(([, value]) => descendants(value as Node[], name)));
+
+/** alphaTab matches unnumbered tie stops before applying instrument transposition,
+ * against already-transposed starts. Give complete, unambiguous written-pitch
+ * chains explicit IDs in disposable playback input. Never mutate source bytes. */
+export function normalizeMusicXmlTransposedTies(bytes: Uint8Array): Uint8Array {
+  const source = new TextDecoder().decode(bytes);
+  if (!/<transpose(?:\s|>)/.test(source) || !/<tied(?:\s|>)/.test(source)) return bytes;
+  const tree = parser.parse(source) as Node[];
+  const root = tree.find(node => tag(node) === 'score-partwise');
+  if (!root) return bytes;
+  let changed = false;
+  for (const part of children(root, 'score-partwise').filter(node => tag(node) === 'part')) {
+    const contents = children(part, 'part');
+    if (!descendants(contents, 'transpose').some(node =>
+      ['chromatic', 'octave-change'].some(name => Number(text(children(node, 'transpose'), name)) !== 0))) continue;
+    const reserved = new Set(descendants(contents, 'tied').map(node => attributes(node)['@_number']).filter(Boolean));
+    const active = new Map<string, { id: string; marker: Node; end: number }>();
+    const ambiguous = new Set<string>();
+    let divisions = 1;
+    let measureStart = 0;
+    const occupied = new Set(reserved);
+    const changedNotations = new Set<Node>();
+    for (const measure of contents.filter(node => tag(node) === 'measure')) {
+      let cursor = 0;
+      let extent = 0;
+      let previousOnset = 0;
+      for (const note of children(measure, 'measure')) {
+        const kind = tag(note);
+        if (kind === 'attributes') {
+          const value = Number(text(children(note, kind), 'divisions'));
+          if (Number.isFinite(value) && value > 0) divisions = value;
+          continue;
+        }
+        if (kind === 'backup' || kind === 'forward') {
+          const length = Number(text(children(note, kind), 'duration')) / divisions;
+          cursor += kind === 'backup' ? -length : length;
+          extent = Math.max(extent, cursor);
+          continue;
+        }
+        if (kind !== 'note') continue;
+        const content = children(note, 'note');
+        if (content.some(node => tag(node) === 'grace')) continue;
+        const duration = Number(text(content, 'duration')) / divisions;
+        const chord = content.some(node => tag(node) === 'chord');
+        const onset = chord ? previousOnset : cursor;
+        if (!chord) { previousOnset = onset; cursor += duration; }
+        extent = Math.max(extent, onset + duration, cursor);
+        const pitch = content.find(node => tag(node) === 'pitch');
+        if (!pitch) continue;
+        const p = children(pitch, 'pitch');
+        const key = [text(content, 'staff') || '1', text(content, 'voice') || '1', text(p, 'step'), text(p, 'alter') || '0', text(p, 'octave')].join(':');
+        const notations = content.filter(node => tag(node) === 'notations');
+        const markers = notations.flatMap(node => children(node, 'notations').filter(child => tag(child) === 'tied' && !attributes(child)['@_number']));
+        // Stops must consume the old ID before a continuation starts a new chain.
+        for (const marker of markers.filter(node => attributes(node)['@_type'] === 'stop')) {
+          if (ambiguous.delete(key)) continue;
+          const start = active.get(key);
+          if (!start) continue;
+          if (!Number.isFinite(duration) || duration <= 0 || Math.abs(start.end - (measureStart + onset)) > 1e-7) {
+            occupied.delete(start.id); active.delete(key); continue;
+          }
+          start.marker[':@'] = { ...attributes(start.marker), '@_number': start.id };
+          marker[':@'] = { ...attributes(marker), '@_number': start.id };
+          active.delete(key);
+          occupied.delete(start.id);
+          changed = true;
+          for (const notation of notations) changedNotations.add(notation);
+        }
+        for (const marker of markers.filter(node => attributes(node)['@_type'] === 'start')) {
+          // Duplicate starts cannot be resolved safely from this written-pitch key.
+          if (active.has(key)) { occupied.delete(active.get(key)!.id); active.delete(key); ambiguous.add(key); continue; }
+          if (ambiguous.has(key) || !Number.isFinite(duration) || duration <= 0) continue;
+          const id = Array.from({length:16}, (_, index) => String(index + 1)).find(value => !occupied.has(value));
+          if (!id) continue;
+          occupied.add(id);
+          active.set(key, { id, marker, end: measureStart + onset + duration });
+        }
+      }
+      measureStart += extent;
+    }
+    for (const notation of changedNotations) {
+      const content = children(notation, 'notations');
+      const indices = content.map((node, index) => tag(node) === 'tied' ? index : -1).filter(index => index >= 0);
+      const markers = indices.map(index => content[index]).sort((a, b) =>
+        (attributes(a)['@_type'] === 'stop' ? 0 : 1) - (attributes(b)['@_type'] === 'stop' ? 0 : 1));
+      indices.forEach((index, markerIndex) => { content[index] = markers[markerIndex]; });
+    }
+  }
+  return changed ? new TextEncoder().encode(builder.build(tree)) : bytes;
+}
