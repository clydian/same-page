@@ -0,0 +1,93 @@
+import { readFileSync } from 'node:fs';
+import { BeatCloner } from '@coderline/alphatab/generated/model/BeatCloner';
+import { MusicXmlImporter } from '@coderline/alphatab/importer/MusicXmlImporter';
+import { ByteBuffer } from '@coderline/alphatab/io/ByteBuffer';
+import { JsonConverter } from '@coderline/alphatab/model/JsonConverter';
+import { NotationElement } from '@coderline/alphatab/NotationSettings';
+import { ScoreRenderer } from '@coderline/alphatab/rendering/ScoreRenderer';
+import { Settings } from '@coderline/alphatab/Settings';
+import { StaveProfile } from '@coderline/alphatab/StaveProfile';
+import { describe, expect, it } from 'vitest';
+
+const xml = readFileSync('test-data/musicxml-lyrics/above-and-below-voices.musicxml', 'utf8');
+function load(input = xml) {
+    const settings = new Settings();
+    settings.core.engine = 'svg';
+    settings.core.enableLazyLoading = false;
+    settings.display.staveProfile = StaveProfile.Score;
+    const importer = new MusicXmlImporter();
+    importer.init(ByteBuffer.fromBuffer(new TextEncoder().encode(input)), settings);
+    return { score: importer.readScore(), settings };
+}
+function render(input: string, hide = false) {
+    const { score, settings } = load(input),
+        renderer = new ScoreRenderer(settings),
+        svg: string[] = [];
+    if (hide) {
+        settings.notation.elements.set(NotationElement.EffectLyrics, false);
+    }
+    renderer.width = 1000;
+    renderer.error.on(error => {
+        throw error;
+    });
+    renderer.partialRenderFinished.on(e => {
+        if (typeof e.renderResult === 'string') {
+            svg.push(e.renderResult);
+        }
+    });
+    renderer.renderScore(score, [0]);
+    const output = svg.join('');
+    // Use the actual five staff strokes: lineAlignedBounds includes effect-band
+    // whitespace here and is not a reliable staff-bottom assertion.
+    const staffYs = [...output.matchAll(/<rect x="[^"]+" y="([^"]+)" width="([^"]+)" height="([^"]+)"/g)]
+        .filter(m => Number(m[2]) > 50 && Number(m[3]) > 1 && Number(m[3]) < 2)
+        .map(m => Number(m[1]));
+    expect(new Set(staffYs).size).toBe(5);
+    return { svg: output, topLine: Math.min(...staffYs), bottomLine: Math.max(...staffYs) };
+}
+describe('source lyric above/below placement', () => {
+    it('retains authored placement independently of verse number and voice', () => {
+        const { score } = load(),
+            first = score.tracks[0].staves[0].bars[0];
+        expect(first.voices[0].beats[2].lyricElements?.[1].placement).toBe(1);
+        expect(first.voices[1].beats[1].lyricElements?.[0].placement).toBe(0);
+    });
+    it('preserves placement through Worker JSON serialization and beat cloning', () => {
+        const { score } = load(),
+            beat = score.tracks[0].staves[0].bars[0].voices[0].beats[2];
+        const copy = JsonConverter.jsObjectToScore(JsonConverter.scoreToJsObject(score));
+        expect(copy.tracks[0].staves[0].bars[0].voices[0].beats[2].lyricElements?.[1].placement).toBe(1);
+        expect(BeatCloner.clone(beat).lyricElements?.[1].placement).toBe(1);
+    });
+    it('places the upper I above the actual staff and the lower I below', () => {
+        const result = render(xml);
+        const ys = [...result.svg.matchAll(/<text[^>]* y="([^"]+)"[^>]*>I<\/text>/g)].map(m => Number(m[1]));
+        expect(ys.length).toBe(2);
+        expect(Math.min(...ys) + 12).toBeLessThan(result.topLine);
+        expect(Math.max(...ys)).toBeGreaterThan(result.bottomLine);
+    });
+    it('does not silently collapse authored above and below into identical output', () => {
+        const below = xml.replace(/(<lyric\b[^>]*placement=)"above"/g, '$1"below"');
+        expect(render(xml).svg).not.toEqual(render(below).svg);
+    });
+    it('keeps native extender geometry in the authored above lane', () => {
+        const original = readFileSync('test-data/musicxml-lyrics/extenders.musicxml', 'utf8');
+        const above = original.replace(/<lyric\b/g, '<lyric placement="above"');
+        const result = render(above);
+        const ys = [...result.svg.matchAll(/<rect x="[^"]+" y="([^"]+)" width="[^"]+" height="0.75"/g)].map(m =>
+            Number(m[1])
+        );
+        expect(ys.length).toBeGreaterThan(2);
+        expect(Math.max(...ys)).toBeLessThan(result.topLine);
+    });
+    it('respects native lyric visibility for both placement lanes', () => {
+        const output = render(xml, true).svg;
+        expect(output).not.toContain('>I</text>');
+        expect(output).not.toContain('>be</text>');
+        expect(output).not.toContain('>lieve</text>');
+    });
+    it('keeps omitted placement identical to explicit default below', () => {
+        const below = xml.replace(/(<lyric\b[^>]*placement=)"above"/g, '$1"below"');
+        expect(render(below).svg).toEqual(render(below.replace(/ placement="below"/g, '')).svg);
+    });
+});
diff --git a/packages/alphatab/test/rendering/MusicXmlCrossStaffSlur.test.ts b/packages/alphatab/test/rendering/MusicXmlCrossStaffSlur.test.ts
new file mode 100644
index 0000000..c237997
--- /dev/null
+++ b/packages/alphatab/test/rendering/MusicXmlCrossStaffSlur.test.ts
@@ -0,0 +1,284 @@
+import { MusicXmlImporter } from '@coderline/alphatab/importer/MusicXmlImporter';
+import { ByteBuffer } from '@coderline/alphatab/io/ByteBuffer';
+import { JsonConverter } from '@coderline/alphatab/model/JsonConverter';
+import { ScoreRenderer } from '@coderline/alphatab/rendering/ScoreRenderer';
+import { ScoreTieGlyph } from '@coderline/alphatab/rendering/glyphs/ScoreTieGlyph';
+import { ScoreSlurGlyph } from '@coderline/alphatab/rendering/glyphs/ScoreSlurGlyph';
+import { BeatXPosition } from '@coderline/alphatab/rendering/BeatXPosition';
+import { TieGlyph } from '@coderline/alphatab/rendering/glyphs/TieGlyph';
+import { Settings } from '@coderline/alphatab/Settings';
+import { LayoutMode } from '@coderline/alphatab/LayoutMode';
+import { describe, expect, it, vi } from 'vitest';
+function source(startStaff = 2, endStaff = 1, startVoice = 1, endVoice = 1) {
+    const n = (staff: number, voice: number, type: string) =>
+        `<note><pitch><step>C</step><octave>4</octave></pitch><duration>2</duration><voice>${voice}</voice><type>half</type><staff>${staff}</staff><notations><slur type="${type}" number="1" placement="above"/></notations></note>`;
+    return `<score-partwise><part-list><score-part id="P1"><part-name>Piano</part-name></score-part></part-list><part id="P1"><measure number="1"><attributes><divisions>1</divisions><time><beats>4</beats><beat-type>4</beat-type></time><staves>2</staves><clef number="1"><sign>G</sign><line>2</line></clef><clef number="2"><sign>F</sign><line>4</line></clef></attributes>${n(startStaff, startVoice, 'start')}${n(endStaff, endVoice, 'stop')}</measure></part></score-partwise>`;
+}
+function load(xml: string) {
+    const importer = new MusicXmlImporter();
+    importer.init(ByteBuffer.fromBuffer(new TextEncoder().encode(xml)), new Settings());
+    return importer.readScore();
+}
+function origins(xml: string) {
+    return load(xml)
+        .tracks.flatMap(t =>
+            t.staves.flatMap(s => s.bars.flatMap(b => b.voices.flatMap(v => v.beats.flatMap(b => b.notes))))
+        )
+        .filter(n => n.isSlurOrigin);
+}
+describe('MusicXML cross-staff phrase slurs', () => {
+    it.each([
+        [2, 1],
+        [1, 2]
+    ])('connects numbered same-voice slur staff %i to %i', (a, b) => {
+        const o = origins(source(a, b));
+        expect(o).toHaveLength(1);
+        expect(o[0].slurDestination?.beat.voice.bar.staff.index).toBe(b - 1);
+    });
+    it('retains same-staff legacy lookup', () => {
+        expect(origins(source(1, 1))).toHaveLength(1);
+    });
+    it('uses the explicit number across voices rather than assuming voice identity', () => {
+        expect(origins(source(2, 1, 1, 2))).toHaveLength(1);
+    });
+    it('does not connect a different numbered stop', () => {
+        expect(origins(source().replace('type="stop" number="1"', 'type="stop" number="2"'))).toHaveLength(0);
+    });
+    it('does not match an origin in another part', () => {
+        const second = source()
+            .replaceAll('P1', 'P2')
+            .match(/<part id="P2">[\s\S]*<\/part>/)![0]
+            .replace('<slur type="start" number="1" placement="above"/>', '');
+        const first = source()
+            .replace('<slur type="stop" number="1" placement="above"/>', '')
+            .replace('</part-list>', '<score-part id="P2"><part-name>Piano2</part-name></score-part></part-list>')
+            .replace('</score-partwise>', `${second}</score-partwise>`);
+        expect(origins(first)).toHaveLength(0);
+    });
+    it('rejects an ambiguous cross-staff fallback instead of choosing a staff', () => {
+        const extra =
+            '<backup><duration>2</duration></backup><note><pitch><step>E</step><octave>4</octave></pitch><duration>2</duration><voice>2</voice><type>half</type><staff>3</staff><notations><slur type="start" number="1"/></notations></note>';
+        const xml = source()
+            .replace('<staves>2</staves>', '<staves>3</staves>')
+            .replace(
+                /<note><pitch><step>C<\/step><octave>4<\/octave><\/pitch><duration>2<\/duration><voice>1<\/voice><type>half<\/type><staff>1<\/staff>/,
+                extra +
+                    '<note><pitch><step>C</step><octave>4</octave></pitch><duration>2</duration><voice>1</voice><type>half</type><staff>1</staff>'
+            );
+        expect(origins(xml)).toHaveLength(0);
+    });
+    it('draws one continuous cross-staff segment, not two system-break halves', () => {
+        const settings = new Settings();
+        settings.core.engine = 'svg';
+        const score = load(source()),
+            renderer = new ScoreRenderer(settings);
+        renderer.width = 900;
+        const segments = new Map<ScoreSlurGlyph, { y1: number; y2: number }>();
+        const original = ScoreSlurGlyph.prototype.doLayout;
+        const spy = vi.spyOn(ScoreSlurGlyph.prototype, 'doLayout').mockImplementation(function (this: ScoreSlurGlyph) {
+            original.call(this);
+            if (Reflect.get(this, '_shouldPaint')) {
+                segments.set(this, { y1: Reflect.get(this, '_startY'), y2: Reflect.get(this, '_endY') });
+            } else {
+                segments.delete(this);
+            }
+        });
+        renderer.error.on(error => {
+            throw error;
+        });
+        try {
+            renderer.renderScore(score, [0]);
+        } finally {
+            spy.mockRestore();
+            renderer.destroy();
+        }
