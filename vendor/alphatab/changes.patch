@@ -0,0 +1,89 @@
+import { MusicXmlImporter } from '@coderline/alphatab/importer/MusicXmlImporter';
+import { ByteBuffer } from '@coderline/alphatab/io/ByteBuffer';
+import { LayoutMode } from '@coderline/alphatab/LayoutMode';
+import { JsonConverter } from '@coderline/alphatab/model/JsonConverter';
+import { ModelUtils } from '@coderline/alphatab/model/ModelUtils';
+import { ScoreRenderer } from '@coderline/alphatab/rendering/ScoreRenderer';
+import { Settings } from '@coderline/alphatab/Settings';
+import { StaveProfile } from '@coderline/alphatab/StaveProfile';
+import { describe, expect, it } from 'vitest';
+
+function load(step: string, alter: number, octave: number) {
+    const xml = `<score-partwise version="4.0"><part-list><score-part id="P1"><part-name>Piano</part-name></score-part></part-list><part id="P1"><measure number="1"><attributes><divisions>1</divisions><key><fifths>1</fifths></key><time><beats>4</beats><beat-type>4</beat-type></time><clef><sign>F</sign><line>4</line></clef></attributes><note><pitch><step>${step}</step><alter>${alter}</alter><octave>${octave}</octave></pitch><duration>4</duration><type>whole</type></note></measure></part></score-partwise>`;
+    return loadXml(xml);
+}
+function loadXml(xml: string, settings = new Settings()) {
+    const importer = new MusicXmlImporter();
+    importer.init(ByteBuffer.fromBuffer(new TextEncoder().encode(xml)), settings);
+    return JsonConverter.jsObjectToScore(JsonConverter.scoreToJsObject(importer.readScore()));
+}
+
+describe('MusicXML source pitch spelling without an explicit accidental glyph', () => {
+    for (const [step, alter, octave, degree, midi] of [
+        ['B', -1, 2, 6, 46],
+        ['E', -1, 2, 2, 39],
+        ['F', 0, 4, 3, 65],
+        ['B', 1, 3, 6, 60],
+        ['C', -1, 4, 0, 59],
+        ['C', 2, 4, 0, 62],
+        ['E', -2, 4, 2, 62]
+    ] as const) {
+        it(`retains ${step}${alter} in octave ${octave} through Worker JSON`, () => {
+            const score = load(step, alter, octave);
+            const bar = score.tracks[0].staves[0].bars[0];
+            const note = bar.voices[0].beats[0].notes[0];
+            expect(note.realValue).toBe(midi);
+            const spelling = ModelUtils.resolveSpelling(bar.keySignature, note.displayValue, note.accidentalMode);
+            expect([spelling.degree, spelling.accidentalOffset, spelling.octave]).toEqual([degree, alter, octave]);
+        });
+    }
+    for (const layout of [LayoutMode.Page, LayoutMode.Horizontal]) {
+        it(`does not draw an A sharp or repeat a carried B flat in layout ${layout}`, () => {
+            const notes = [
+                ['E', -1, 2, true],
+                ['B', -1, 2, true],
+                ['G', 0, 3, false],
+                ['B', -1, 2, false],
+                ['B', -1, 3, true]
+            ]
+                .map(
+                    ([step, alter, octave, explicit], i) =>
+                        `<note><pitch><step>${step}</step><alter>${alter}</alter><octave>${octave}</octave></pitch><duration>${i === 4 ? 2 : 1}</duration><type>${i === 4 ? 'quarter' : 'eighth'}</type>${explicit ? '<accidental>flat</accidental>' : ''}</note>`
+                )
+                .join('');
+            const xml = `<score-partwise version="4.0"><part-list><score-part id="P1"><part-name>Piano</part-name></score-part></part-list><part id="P1"><measure number="1"><attributes><divisions>2</divisions><key><fifths>1</fifths></key><time><beats>3</beats><beat-type>4</beat-type></time><clef><sign>F</sign><line>4</line></clef></attributes>${notes}</measure></part></score-partwise>`;
+            const settings = new Settings();
+            settings.core.engine = 'svg';
+            settings.core.enableLazyLoading = false;
+            settings.display.staveProfile = StaveProfile.Score;
+            settings.display.layoutMode = layout;
+            const score = loadXml(xml, settings);
+            expect(score.tracks[0].staves[0].bars[0].voices[0].beats.map(b => b.notes[0].realValue)).toEqual([
+                39, 46, 55, 46, 58
+            ]);
+            const renderer = new ScoreRenderer(settings);
+            renderer.width = 1200;
+            const pieces: string[] = [];
+            renderer.partialRenderFinished.on(event => {
+                if (typeof event.renderResult === 'string') {
+                    pieces.push(event.renderResult);
+                }
+            });
+            renderer.error.on(error => {
+                throw error;
+            });
+            try {
+                renderer.renderScore(score, [0]);
+            } finally {
+                renderer.destroy();
+            }
+            const svg = pieces
+                .join('')
+                .replace(/&#x([0-9a-f]+);/gi, (_, hex) => String.fromCodePoint(Number.parseInt(hex, 16)))
+                .replace(/&#(\d+);/g, (_, n) => String.fromCodePoint(Number(n)));
+            expect(pieces.length).toBeGreaterThan(0);
+            expect((svg.match(/\uE262/g) ?? []).length).toBe(1); // key signature F sharp only
+            expect((svg.match(/\uE260/g) ?? []).length).toBe(3); // E flat, B flat, octave B flat
+        });
+    }
+});
diff --git a/packages/alphatab/test/importer/MusicXmlStaffOctaveScope.test.ts b/packages/alphatab/test/importer/MusicXmlStaffOctaveScope.test.ts
new file mode 100644
index 0000000..e39514e
--- /dev/null
+++ b/packages/alphatab/test/importer/MusicXmlStaffOctaveScope.test.ts
@@ -0,0 +1,110 @@
+import { MusicXmlImporter } from '@coderline/alphatab/importer/MusicXmlImporter';
+import { ByteBuffer } from '@coderline/alphatab/io/ByteBuffer';
+import { LayoutMode } from '@coderline/alphatab/LayoutMode';
+import { JsonConverter } from '@coderline/alphatab/model/JsonConverter';
+import { Ottavia } from '@coderline/alphatab/model/Ottavia';
+import { ScoreRenderer } from '@coderline/alphatab/rendering/ScoreRenderer';
+import { Settings } from '@coderline/alphatab/Settings';
+import { StaveProfile } from '@coderline/alphatab/StaveProfile';
+import { describe, expect, it } from 'vitest';
+
+const source =
+    '<?xml version=\'1.0\' encoding=\'UTF-8\'?>\n<score-partwise version="4.0"><part-list><score-part id="P"><part-name>Owned staff-scope</part-name></score-part></part-list><part id="P"><measure number="1"><attributes><divisions>4</divisions><key><fifths>0</fifths></key><time><beats>3</beats><beat-type>4</beat-type></time><staves>2</staves><clef number="1"><sign>G</sign><line>2</line></clef><clef number="2"><sign>G</sign><line>2</line></clef></attributes><direction placement="above"><direction-type><octave-shift type="down" size="8" number="1"/></direction-type><staff>1</staff></direction><note><pitch><step>C</step><octave>6</octave></pitch><duration>12</duration><voice>1</voice><type>half</type><dot/><stem>up</stem><staff>1</staff></note><backup><duration>12</duration></backup><note><pitch><step>C</step><octave>4</octave></pitch><duration>12</duration><voice>2</voice><type>half</type><dot/><stem>up</stem><staff>2</staff></note></measure><measure number="2"><direction placement="above"><direction-type><octave-shift type="stop" size="8" number="1"/></direction-type><staff>1</staff></direction><note><pitch><step>C</step><octave>5</octave></pitch><duration>12</duration><voice>1</voice><type>half</type><dot/><stem>up</stem><staff>1</staff></note><backup><duration>12</duration></backup><note><pitch><step>C</step><octave>4</octave></pitch><duration>12</duration><voice>2</voice><type>half</type><dot/><stem>up</stem><staff>2</staff></note></measure></part></score-partwise>';
+function load(xml: string) {
+    const i = new MusicXmlImporter();
+    i.init(ByteBuffer.fromBuffer(new TextEncoder().encode(xml)), new Settings());
+    return JsonConverter.jsObjectToScore(JsonConverter.scoreToJsObject(i.readScore()));
+}
+function values(xml: string) {
+    return load(xml).tracks.map(t =>
+        t.staves.map(s =>
+            s.bars.map(b =>
+                b.voices.flatMap(v =>
+                    v.beats
+                        .filter(be => be.notes.length)
+                        .map(be => ({
+                            ottava: be.ottava,
+                            keys: be.notes.map(n => n.realValue),
+                            display: be.notes.map(n => n.displayValue)
+                        }))
+                )
+            )
+        )
+    );
+}
+function lowerStaffGeometry(xml: string, layout: LayoutMode) {
+    const settings = new Settings();
+    settings.core.engine = 'svg';
+    settings.core.enableLazyLoading = false;
+    settings.core.includeNoteBounds = true;
+    settings.display.staveProfile = StaveProfile.Score;
+    settings.display.layoutMode = layout;
+    const score = load(xml),
+        renderer = new ScoreRenderer(settings),
+        svg: string[] = [];
+    renderer.width = 1000;
+    renderer.error.on(error => {
+        throw error;
+    });
+    renderer.partialRenderFinished.on(event => {
+        if (typeof event.renderResult === 'string') {
+            svg.push(event.renderResult);
+        }
+    });
+    try {
+        renderer.renderScore(score, [0]);
+        expect(svg.length).toBeGreaterThan(0);
+        const beat = score.tracks[0].staves[1].bars[0].voices.flatMap(v => v.beats).find(b => b.notes.length)!;
+        const bounds = renderer.boundsLookup!.findBeat(beat)!;
+        expect(bounds.notes!.length).toBe(1);
+        const head = bounds.notes![0].noteHeadBounds;
+        return { y: head.y - bounds.barBounds.realBounds.y, h: head.h };
+    } finally {
+        renderer.destroy();
+    }
+}
+describe('MusicXML octave shift staff scope', () => {
+    it('keeps staff2 regular when only staff1 starts and stops an octave line, through Worker JSON', () => {
+        const rows = values(source)[0];
+        expect(rows[0][0][0]).toEqual({ ottava: Ottavia._8va, keys: [84], display: [72] });
+        expect(rows[1][0][0]).toEqual({ ottava: Ottavia.Regular, keys: [60], display: [60] });
+        expect(rows[0][1][0]).toEqual({ ottava: Ottavia.Regular, keys: [72], display: [72] });
+        expect(rows[1][1][0]).toEqual({ ottava: Ottavia.Regular, keys: [60], display: [60] });
+    });
+    it('maintains independent simultaneous octave shifts and stopping one staff leaves the other active', () => {
+        const second =
+            '<direction><direction-type><octave-shift type="up" size="15"/></direction-type><staff>2</staff></direction>';
+        const xml = source.replace('<note>', second + '<note>');
+        const rows = values(xml)[0];
+        expect(rows[0][0][0].ottava).toBe(Ottavia._8va);
+        expect(rows[1][0][0]).toEqual({ ottava: Ottavia._15mb, keys: [60], display: [84] });
+        expect(rows[0][1][0].ottava).toBe(Ottavia.Regular);
+        expect(rows[1][1][0].ottava).toBe(Ottavia._15mb);
+    });
+    it('continues the addressed staff state instead of a different staff state', () => {
+        const second =
+            '<direction><direction-type><octave-shift type="up" size="15"/></direction-type><staff>2</staff></direction>';
+        const xml = source.replace('<note>', second + '<note>').replace('type="stop"', 'type="continue"');
+        const rows = values(xml)[0];
+        expect(rows[0][1][0].ottava).toBe(Ottavia._8va);
+        expect(rows[1][1][0].ottava).toBe(Ottavia._15mb);
+    });
+    it('does not carry an unclosed octave shift into the next part with the same staff numbers', () => {
+        const first = source.replace('type="stop"', 'type="continue"');
+        const second = source
+            .match(/<part id="P">[\s\S]*<\/part>/)![0]
+            .replace('id="P"', 'id="Q"')
+            .replace(/<direction[\s\S]*?<\/direction>/g, '');
+        const xml = first
+            .replace('</part-list>', '<score-part id="Q"><part-name>Second part</part-name></score-part></part-list>')
+            .replace('</score-partwise>', second + '</score-partwise>');
+        expect(values(xml)[1][0][0][0].ottava).toBe(Ottavia.Regular);
+        expect(values(xml)[1][1][0][0].ottava).toBe(Ottavia.Regular);
+    });
+    for (const layout of [LayoutMode.Page, LayoutMode.Horizontal]) {
+        it(`keeps the actual lower-staff notehead at the control staff position in ${LayoutMode[layout]}`, () => {
+            const control = source.replace(/<direction[\s\S]*?<\/direction>/g, '');
+            expect(lowerStaffGeometry(source, layout)).toEqual(lowerStaffGeometry(control, layout));
+        });
+    }
+});
diff --git a/packages/alphatab/test/importer/MusicXmlStemVisibility.test.ts b/packages/alphatab/test/importer/MusicXmlStemVisibility.test.ts
new file mode 100644
index 0000000..20b04b8
--- /dev/null
+++ b/packages/alphatab/test/importer/MusicXmlStemVisibility.test.ts
@@ -0,0 +1,136 @@
+import { BeatCloner } from '@coderline/alphatab/generated/model/BeatCloner';
+import { BeatSerializer } from '@coderline/alphatab/generated/model/BeatSerializer';
+import { Beat } from '@coderline/alphatab/model/Beat';
+import { MusicXmlImporter } from '@coderline/alphatab/importer/MusicXmlImporter';
+import { ByteBuffer } from '@coderline/alphatab/io/ByteBuffer';
+import { AlphaSynthMidiFileHandler } from '@coderline/alphatab/midi/AlphaSynthMidiFileHandler';
+import { MidiFile } from '@coderline/alphatab/midi/MidiFile';
+import { MidiFileGenerator } from '@coderline/alphatab/midi/MidiFileGenerator';
+import { JsonConverter } from '@coderline/alphatab/model/JsonConverter';
+import { ScoreRenderer } from '@coderline/alphatab/rendering/ScoreRenderer';
+import { Settings } from '@coderline/alphatab/Settings';
+import { describe, expect, it } from 'vitest';
+
+function source(type: string, stem?: string, chord = false): string {
+    const durations: Record<string, number> = { quarter: 2, half: 4, eighth: 1 };
+    const n = (step: string, extra = '') =>
+        `<note>${extra}<pitch><step>${step}</step><octave>4</octave></pitch><duration>${durations[type]}</duration><type>${type}</type>${stem ? `<stem>${stem}</stem>` : ''}</note>`;
+    return `<score-partwise version="4.0"><part-list><score-part id="P"><part-name>Owned stem</part-name></score-part></part-list><part id="P"><measure number="1" implicit="yes"><attributes><divisions>2</divisions><time><beats>4</beats><beat-type>4</beat-type></time><clef><sign>G</sign><line>2</line></clef></attributes>${n('E')}${chord ? n('G', '<chord/>') : ''}</measure></part></score-partwise>`;
+}
+function capture(xml: string) {
+    const importer = new MusicXmlImporter();
+    importer.init(ByteBuffer.fromBuffer(new TextEncoder().encode(xml)), new Settings());
+    const score = JsonConverter.jsObjectToScore(JsonConverter.scoreToJsObject(importer.readScore()));
+    const settings = new Settings();
+    settings.core.engine = 'svg';
+    settings.core.enableLazyLoading = false;
+    const renderer = new ScoreRenderer(settings),
+        pieces: string[] = [];
+    renderer.width = 900;
+    renderer.partialRenderFinished.on(e => {
+        if (typeof e.renderResult === 'string') {
+            pieces.push(e.renderResult);
+        }
+    });
+    renderer.error.on(e => {
+        throw e;
+    });
+    try {
+        renderer.renderScore(score, [0]);
+    } finally {
+        renderer.destroy();
+    }
+    const file = new MidiFile(),
+        generator = new MidiFileGenerator(score, settings, new AlphaSynthMidiFileHandler(file));
+    generator.generate();
+    return {
+        score,
+        svg: pieces.join(''),
+        events: file.tracks.flatMap(t => t.events).map(e => JSON.parse(JSON.stringify(e))),
+        bounds: generator.tickLookup.masterBars.map(b => [b.start, b.end])
+    };
+}
+const stemRects = (svg: string) => svg.match(/<rect\b[^>]*width="1\.08"[^>]*>/g) ?? [];
+const normalized = (svg: string) => svg.replace(/>\s+</g, '><');
+const withoutStems = (svg: string) => normalized(svg.replace(/<rect\b[^>]*width="1\.08"[^>]*>/g, ''));
+describe('MusicXML stem none display independent of musical timing', () => {
+    for (const type of ['quarter', 'half', 'eighth']) {
+        it(`retains ${type} stem visibility through public JSON and changes SVG only`, () => {
+            const hidden = capture(source(type, 'none')),
+                normal = capture(source(type, 'up'));
+            expect(stemRects(normal.svg)).toHaveLength(1);
+            expect(stemRects(hidden.svg)).toHaveLength(0);
+            expect(normalized(hidden.svg)).toBe(withoutStems(normal.svg));
+            expect(Reflect.get(hidden.score.tracks[0].staves[0].bars[0].voices[0].beats[0], 'isStemVisible')).toBe(
+                false
+            );
+            expect(hidden.events).toEqual(normal.events);
+            expect(hidden.bounds).toEqual(normal.bounds);
+        });
+    }
+    it('retains the shared chord noteheads and all attacks', () => {
+        const a = capture(source('half', 'none', true)),
+            b = capture(source('half', 'up', true));
+        expect(stemRects(a.svg)).toHaveLength(0);
+        expect(stemRects(b.svg)).toHaveLength(1);
+        expect(normalized(a.svg)).toBe(withoutStems(b.svg));
+        expect(a.events).toEqual(b.events);
+    });
+    it('retains beam strokes and flags rather than hiding the whole rhythmic group', () => {
+        const beamed = (stem: string) =>
+            source('eighth', stem).replace(
+                '</measure>',
+                '<note><pitch><step>F</step><octave>4</octave></pitch><duration>1</duration><type>eighth</type><stem>' +
+                    stem +
+                    '</stem></note></measure>'
+            );
+        const a = capture(beamed('none')),
+            b = capture(beamed('up'));
+        expect(stemRects(b.svg)).toHaveLength(2);
+        expect(stemRects(a.svg)).toHaveLength(0);
+        expect(normalized(a.svg)).toBe(withoutStems(b.svg));
+        expect(a.events).toEqual(b.events);
+    });
+    it('does not hide a later beat or an independent voice', () => {
+        const xml = source('quarter', 'none').replace(
+            '</measure>',
+            '<backup><duration>2</duration></backup><note><pitch><step>C</step><octave>4</octave></pitch><duration>2</duration><voice>2</voice><type>quarter</type><stem>down</stem></note></measure>'
+        );
+        const c = capture(xml);
+        expect(stemRects(c.svg)).toHaveLength(1);
+        expect(c.score.tracks[0].staves[0].bars[0].voices.map(v => v.beats[0].isStemVisible)).toEqual([false, true]);
+    });
+    it('keeps another staff stem and does not change cross-staff note positions', () => {
+        const xml = source('quarter', 'none')
+            .replace(
+                '</attributes>',
+                '<staves>2</staves><clef number="2"><sign>F</sign><line>4</line></clef></attributes>'
+            )
+            .replace(
+                '</measure>',
+                '<backup><duration>2</duration></backup><note><pitch><step>C</step><octave>3</octave></pitch><duration>2</duration><voice>2</voice><type>quarter</type><stem>up</stem><staff>2</staff></note></measure>'
+            );
+        const a = capture(xml),
+            b = capture(xml.replace('<stem>none</stem>', '<stem>up</stem>'));
+        expect(stemRects(a.svg)).toHaveLength(1);
+        expect(stemRects(b.svg)).toHaveLength(2);
+        expect(
+            a.score.tracks[0].staves.map(s =>
+                s.bars[0].voices.flatMap(v => v.beats.filter(b => b.notes.length).map(b => b.isStemVisible))
+            )
+        ).toEqual([[false], [true]]);
+        expect(a.events).toEqual(b.events);
+        expect(a.bounds).toEqual(b.bounds);
+    });
+    it('clones false and retains true for legacy Worker JSON without the field', () => {
+        const b = new Beat();
+        b.isStemVisible = false;
+        expect(BeatCloner.clone(b).isStemVisible).toBe(false);
+        const old = new Beat();
+        BeatSerializer.fromJson(old, new Map([['duration', 4]]));
+        expect(old.isStemVisible).toBe(true);
+    });
+    it('keeps absent and invalid stem declarations on legacy automatic rendering', () => {
+        expect(capture(source('quarter', 'invalid')).svg).toBe(capture(source('quarter')).svg);
+    });
+});
diff --git a/packages/alphatab/test/importer/MusicXmlTimedStaffNotation.test.ts b/packages/alphatab/test/importer/MusicXmlTimedStaffNotation.test.ts
new file mode 100644
index 0000000..1457784
--- /dev/null
+++ b/packages/alphatab/test/importer/MusicXmlTimedStaffNotation.test.ts
@@ -0,0 +1,265 @@
+import { MusicXmlImporter } from '@coderline/alphatab/importer/MusicXmlImporter';
+import { ByteBuffer } from '@coderline/alphatab/io/ByteBuffer';
+import { AlphaSynthMidiFileHandler } from '@coderline/alphatab/midi/AlphaSynthMidiFileHandler';
+import { MidiFile } from '@coderline/alphatab/midi/MidiFile';
+import { MidiFileGenerator } from '@coderline/alphatab/midi/MidiFileGenerator';
+import { Clef } from '@coderline/alphatab/model/Clef';
+import { JsonConverter } from '@coderline/alphatab/model/JsonConverter';
+import { ModelUtils } from '@coderline/alphatab/model/ModelUtils';
+import { AccidentalHelper } from '@coderline/alphatab/rendering/utils/AccidentalHelper';
+import { LayoutMode } from '@coderline/alphatab/LayoutMode';
+import { ScoreRenderer } from '@coderline/alphatab/rendering/ScoreRenderer';
+import { StaveProfile } from '@coderline/alphatab/StaveProfile';
+import { Settings } from '@coderline/alphatab/Settings';
+import { describe, expect, it } from 'vitest';
+
+const bass = '<clef><sign>F</sign><line>4</line></clef>';
+const treble = '<clef><sign>G</sign><line>2</line></clef>';
+const note = (step: string, octave: number, duration: number, type: string) =>
+    `<note><pitch><step>${step}</step><octave>${octave}</octave></pitch><duration>${duration}</duration><type>${type}</type></note>`;
+function load(measures: string) {
+    const source = `<score-partwise version="4.0"><part-list><score-part id="P"><part-name>Piano</part-name></score-part></part-list><part id="P">${measures}</part></score-partwise>`;
+    const importer = new MusicXmlImporter();
+    importer.init(ByteBuffer.fromBuffer(new TextEncoder().encode(source)), new Settings());
+    return JsonConverter.jsObjectToScore(JsonConverter.scoreToJsObject(importer.readScore()));
+}
+const initial = `<attributes><divisions>1</divisions><time><beats>4</beats><beat-type>4</beat-type></time>${bass}</attributes>`;
+
+function renderNotationScore(score: ReturnType<typeof load>, layout: LayoutMode) {
+    const settings = new Settings();
+    settings.core.engine = 'svg';
+    settings.core.enableLazyLoading = false;
+    settings.display.staveProfile = StaveProfile.Score;
+    settings.display.layoutMode = layout;
+    const renderer = new ScoreRenderer(settings);
+    renderer.width = 1000;
+    const pieces: string[] = [];
+    renderer.partialRenderFinished.on(event => {
+        if (typeof event.renderResult === 'string') {
+            pieces.push(event.renderResult);
+        }
+    });
+    renderer.error.on(error => {
+        throw error;
+    });
+    try {
+        renderer.renderScore(score, [0]);
+    } finally {
+        renderer.destroy();
+    }
+    return pieces
+        .join('')
+        .replace(/&#x([0-9a-f]+);/gi, (_, h) => String.fromCodePoint(Number.parseInt(h, 16)))
+        .replace(/&#(\d+);/g, (_, n) => String.fromCodePoint(Number(n)));
+}
+
+describe('MusicXML staff notation follows musical time rather than attribute document order', () => {
+    for (const layout of [LayoutMode.Page, LayoutMode.Horizontal]) {
+        it(`does not redraw unchanged visible fifths for a mode-only timed key in layout ${layout}`, () => {
+            const attrs = initial.replace(
+                '</attributes>',
+                '<key><fifths>2</fifths><mode>major</mode></key></attributes>'
+            );
+            const score = load(
+                `<measure number="1">${attrs}${note('A', 3, 1, 'quarter')}<attributes><key><fifths>2</fifths><mode>minor</mode></key></attributes>${note('A', 3, 1, 'quarter')}<attributes><key><fifths>2</fifths><mode>dorian</mode></key></attributes>${note('A', 3, 2, 'half')}</measure>`
+            );
+            const bar = score.tracks[0].staves[0].bars[0];
+            expect(bar.notationChanges).toHaveLength(2);
+            expect(bar.getKeySignatureTypeAt(960)).toBe(1);
+            expect(bar.getKeySignatureTypeAt(1920)).toBe(0);
+            expect((renderNotationScore(score, layout).match(/\uE262/g) ?? []).length).toBe(2);
+        });
+    }
+    it('preserves explicit cancellation and a return from hidden to visible key printing', () => {
+        const attrs = initial.replace('</attributes>', '<key><fifths>2</fifths></key></attributes>');
+        const cases = [
+            { changes: '<attributes><key><cancel>2</cancel><fifths>2</fifths></key></attributes>', count: 4 },
+            {
+                changes:
+                    '<attributes><key print-object="no"><fifths>2</fifths></key></attributes><attributes><key><fifths>2</fifths></key></attributes>',
+                count: 4
+            }
+        ];
+        for (const { changes, count } of cases) {
+            const score = load(
+                `<measure number="1">${attrs}${note('A', 3, 1, 'quarter')}${changes}${note('A', 3, 3, 'half')}</measure>`
+            );
+            expect((renderNotationScore(score, LayoutMode.Page).match(/\uE262/g) ?? []).length).toBe(count);
+        }
+    });
+    it('keeps the old clef for a completed bar and carries its end change to the next bar', () => {
+        const score = load(`<measure number="1">${initial}${note('G', 2, 4, 'whole')}<attributes>${treble}</attributes></measure><measure number="2">${note('G', 4, 4, 'whole')}<attributes>${bass}</attributes></measure><measure number="3">${note('G', 2, 4, 'whole')}</measure>`);
+        expect(score.tracks[0].staves[0].bars.map(b => b.clef)).toEqual([Clef.F4, Clef.G2, Clef.F4]);
+    });
+    it('uses the changed clef only for notes at or after its in-bar musical time', () => {
+        const score = load(`<measure number="1">${initial}${note('G', 2, 1, 'quarter')}<attributes>${treble}</attributes>${note('G', 4, 1, 'quarter')}<attributes>${bass}</attributes>${note('G', 2, 2, 'half')}</measure>`);
+        const bar = score.tracks[0].staves[0].bars[0];
+        const expectedClefs = [Clef.F4, Clef.G2, Clef.F4];
+        for (const [index, beat] of bar.voices[0].beats.entries()) {
+            const n = beat.notes[0];
+            const spelling = ModelUtils.resolveSpelling(bar.keySignature, n.displayValue, n.accidentalMode);
+            expect(AccidentalHelper.computeStepsWithoutAccidentals(bar, n)).toBe(AccidentalHelper.calculateNoteSteps(expectedClefs[index], spelling));
+        }
+    });
+    for (const layout of [LayoutMode.Page, LayoutMode.Horizontal]) {
