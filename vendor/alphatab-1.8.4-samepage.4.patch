+import { BeatCloner } from '@coderline/alphatab/generated/model/BeatCloner';
+import { MusicXmlImporter } from '@coderline/alphatab/importer/MusicXmlImporter';
+import { ByteBuffer } from '@coderline/alphatab/io/ByteBuffer';
+import { DynamicValue } from '@coderline/alphatab/model/DynamicValue';
+import { JsonConverter } from '@coderline/alphatab/model/JsonConverter';
+import { MusicFontSymbol } from '@coderline/alphatab/model/MusicFontSymbol';
+import { DynamicsEffectInfo } from '@coderline/alphatab/rendering/effects/DynamicsEffectInfo';
+import { ScoreRenderer } from '@coderline/alphatab/rendering/ScoreRenderer';
+import { Settings } from '@coderline/alphatab/Settings';
+import { StaveProfile } from '@coderline/alphatab/StaveProfile';
+import { describe, expect, it } from 'vitest';
+
+const input = `<score-partwise version="4.0"><part-list><score-part id="P1"><part-name>Voice</part-name></score-part></part-list><part id="P1"><measure number="1"><attributes><divisions>1</divisions><time><beats>4</beats><beat-type>4</beat-type></time><clef><sign>G</sign><line>2</line></clef></attributes><note><pitch><step>C</step><octave>5</octave></pitch><duration>1</duration><type>quarter</type></note><note><rest/><duration>1</duration><type>quarter</type></note><note><pitch><step>D</step><octave>5</octave></pitch><duration>2</duration><type>half</type></note></measure></part></score-partwise>`;
+function load(xml = input) {
+    const settings = new Settings();
+    settings.core.engine = 'svg';
+    settings.core.enableLazyLoading = false;
+    settings.display.staveProfile = StaveProfile.Score;
+    const importer = new MusicXmlImporter();
+    importer.init(ByteBuffer.fromBuffer(new TextEncoder().encode(xml)), settings);
+    const score = importer.readScore();
+    // This caller supplies explicit source declarations after import.
+    score.stylesheet.hideDynamics = false;
+    return { score, settings };
+}
+describe('explicit source dynamic engraving', () => {
+    it('draws an exact declaration on an existing empty cross-staff time anchor', () => {
+        const xml = `<score-partwise version="4.0"><part-list><score-part id="P1"><part-name>Piano</part-name></score-part></part-list><part id="P1"><measure number="1"><attributes><divisions>1</divisions><time><beats>4</beats><beat-type>4</beat-type></time><staves>2</staves><clef number="1"><sign>G</sign><line>2</line></clef><clef number="2"><sign>F</sign><line>4</line></clef></attributes><note><pitch><step>C</step><octave>3</octave></pitch><duration>1</duration><voice>1</voice><type>quarter</type><staff>2</staff></note><note><pitch><step>D</step><octave>4</octave></pitch><duration>3</duration><voice>1</voice><type>half</type><dot/><staff>1</staff></note></measure></part></score-partwise>`;
+        const { score, settings } = load(xml);
+        const empty = score.tracks[0].staves[0].bars[0].voices[0].beats[0];
+        expect(empty.isEmpty).toBe(true);
+        expect(empty.playbackStart).toBe(0);
+        for (const staff of score.tracks[0].staves) {
+            for (const voice of staff.bars[0].voices) {
+                for (const beat of voice.beats) {
+                    beat.dynamics = DynamicValue.P;
+                }
+            }
+        }
+        empty.dynamics = DynamicValue.PP;
+        empty.isDynamicsExplicit = true;
+        const renderer = new ScoreRenderer(settings),
+            svg: string[] = [];
+        renderer.width = 1000;
+        renderer.error.on(error => {
+            throw error;
+        });
+        renderer.partialRenderFinished.on(e => {
+            if (typeof e.renderResult === 'string') {
+                svg.push(e.renderResult);
+            }
+        });
+        renderer.renderScore(score, [0]);
+        expect(svg.join('').split(`&#${MusicFontSymbol.DynamicPP};`).length - 1).toBe(1);
+    });
+    it('draws a source declaration at a rest rather than carrying its glyph to the next note', () => {
+        const { score, settings } = load();
+        const beats = score.tracks[0].staves[0].bars[0].voices[0].beats;
+        for (const beat of beats) {
+            beat.dynamics = DynamicValue.P;
+        }
+        const rest = beats[1];
+        rest.dynamics = DynamicValue.PP;
+        rest.isDynamicsExplicit = true;
+        const effect = new DynamicsEffectInfo();
+        expect(effect.shouldCreateGlyph(settings, rest)).toBe(true);
+        const renderer = new ScoreRenderer(settings),
+            svg: string[] = [];
+        renderer.width = 1000;
+        renderer.error.on(error => {
+            throw error;
+        });
+        renderer.partialRenderFinished.on(e => {
+            if (typeof e.renderResult === 'string') {
+                svg.push(e.renderResult);
+            }
+        });
+        renderer.renderScore(score, [0]);
+        expect(svg.join('').split(`&#${MusicFontSymbol.DynamicPP};`).length - 1).toBe(1);
+    });
+    it('retains consecutive equal source declarations but keeps legacy suppression', () => {
+        const { score, settings } = load(input.replace('<rest/>', '<pitch><step>E</step><octave>5</octave></pitch>'));
+        const beats = score.tracks[0].staves[0].bars[0].voices[0].beats;
+        for (const beat of beats) {
+            beat.dynamics = DynamicValue.P;
+        }
+        const effect = new DynamicsEffectInfo();
+        expect(effect.shouldCreateGlyph(settings, beats[1])).toBe(false);
+        beats[1].isDynamicsExplicit = true;
+        expect(effect.shouldCreateGlyph(settings, beats[1])).toBe(true);
+        score.stylesheet.hideDynamics = true;
+        expect(effect.shouldCreateGlyph(settings, beats[1])).toBe(false);
+    });
+    it('supports a real whole-bar rest in an otherwise empty voice', () => {
+        const { score, settings } = load(
+            input.replace(
+                /<note>[\s\S]*<\/note>/,
+                '<note><rest measure="yes"/><duration>4</duration><type>whole</type></note>'
+            )
+        );
+        const rest = score.tracks[0].staves[0].bars[0].voices[0].beats[0];
+        rest.dynamics = DynamicValue.PP;
+        rest.isDynamicsExplicit = true;
+        expect(new DynamicsEffectInfo().shouldCreateGlyph(settings, rest)).toBe(true);
+    });
+    it('does not repeat an explicit rest declaration at the following note which inherits it', () => {
+        const { score, settings } = load();
+        const beats = score.tracks[0].staves[0].bars[0].voices[0].beats;
+        beats[0].dynamics = DynamicValue.P;
+        beats[1].dynamics = DynamicValue.PP;
+        beats[1].isDynamicsExplicit = true;
+        beats[2].dynamics = DynamicValue.PP;
+        const effect = new DynamicsEffectInfo();
+        expect(effect.shouldCreateGlyph(settings, beats[1])).toBe(true);
+        expect(effect.shouldCreateGlyph(settings, beats[2])).toBe(false);
+    });
+    it('preserves the declaration flag through Worker serialization and cloning', () => {
+        const { score } = load();
+        const rest = score.tracks[0].staves[0].bars[0].voices[0].beats[1];
+        rest.isDynamicsExplicit = true;
+        const copy = JsonConverter.jsObjectToScore(JsonConverter.scoreToJsObject(score));
+        expect(copy.tracks[0].staves[0].bars[0].voices[0].beats[1].isDynamicsExplicit).toBe(true);
+        expect(BeatCloner.clone(rest).isDynamicsExplicit).toBe(true);
+    });
+});
diff --git a/packages/alphatab/test/rendering/LyricsPlacement.test.ts b/packages/alphatab/test/rendering/LyricsPlacement.test.ts
new file mode 100644
index 0000000..4b8928a
--- /dev/null
+++ b/packages/alphatab/test/rendering/LyricsPlacement.test.ts
@@ -0,0 +1,93 @@
+import { readFileSync } from 'node:fs';
+import { BeatCloner } from '@coderline/alphatab/generated/model/BeatCloner';
+import { MusicXmlImporter } from '@coderline/alphatab/importer/MusicXmlImporter';
+import { ByteBuffer } from '@coderline/alphatab/io/ByteBuffer';
+import { JsonConverter } from '@coderline/alphatab/model/JsonConverter';
+import { NotationElement } from '@coderline/alphatab/NotationSettings';
+import { ScoreRenderer } from '@coderline/alphatab/rendering/ScoreRenderer';
+import { Settings } from '@coderline/alphatab/Settings';
+import { StaveProfile } from '@coderline/alphatab/StaveProfile';
+import { describe, expect, it } from 'vitest';
+
+const xml = readFileSync('test-data/musicxml-lyrics/above-and-below-voices.musicxml', 'utf8');
+function load(input = xml) {
+    const settings = new Settings();
+    settings.core.engine = 'svg';
+    settings.core.enableLazyLoading = false;
+    settings.display.staveProfile = StaveProfile.Score;
+    const importer = new MusicXmlImporter();
+    importer.init(ByteBuffer.fromBuffer(new TextEncoder().encode(input)), settings);
+    return { score: importer.readScore(), settings };
+}
+function render(input: string, hide = false) {
+    const { score, settings } = load(input),
+        renderer = new ScoreRenderer(settings),
+        svg: string[] = [];
+    if (hide) {
+        settings.notation.elements.set(NotationElement.EffectLyrics, false);
+    }
+    renderer.width = 1000;
+    renderer.error.on(error => {
+        throw error;
+    });
+    renderer.partialRenderFinished.on(e => {
+        if (typeof e.renderResult === 'string') {
+            svg.push(e.renderResult);
+        }
+    });
+    renderer.renderScore(score, [0]);
+    const output = svg.join('');
+    // Use the actual five staff strokes: lineAlignedBounds includes effect-band
+    // whitespace here and is not a reliable staff-bottom assertion.
+    const staffYs = [...output.matchAll(/<rect x="[^"]+" y="([^"]+)" width="([^"]+)" height="([^"]+)"/g)]
+        .filter(m => Number(m[2]) > 50 && Number(m[3]) > 1 && Number(m[3]) < 2)
+        .map(m => Number(m[1]));
+    expect(new Set(staffYs).size).toBe(5);
+    return { svg: output, topLine: Math.min(...staffYs), bottomLine: Math.max(...staffYs) };
+}
+describe('source lyric above/below placement', () => {
+    it('retains authored placement independently of verse number and voice', () => {
+        const { score } = load(),
+            first = score.tracks[0].staves[0].bars[0];
+        expect(first.voices[0].beats[2].lyricElements?.[1].placement).toBe(1);
+        expect(first.voices[1].beats[1].lyricElements?.[0].placement).toBe(0);
+    });
+    it('preserves placement through Worker JSON serialization and beat cloning', () => {
+        const { score } = load(),
+            beat = score.tracks[0].staves[0].bars[0].voices[0].beats[2];
+        const copy = JsonConverter.jsObjectToScore(JsonConverter.scoreToJsObject(score));
+        expect(copy.tracks[0].staves[0].bars[0].voices[0].beats[2].lyricElements?.[1].placement).toBe(1);
+        expect(BeatCloner.clone(beat).lyricElements?.[1].placement).toBe(1);
+    });
+    it('places the upper I above the actual staff and the lower I below', () => {
+        const result = render(xml);
+        const ys = [...result.svg.matchAll(/<text[^>]* y="([^"]+)"[^>]*>I<\/text>/g)].map(m => Number(m[1]));
+        expect(ys.length).toBe(2);
+        expect(Math.min(...ys) + 12).toBeLessThan(result.topLine);
+        expect(Math.max(...ys)).toBeGreaterThan(result.bottomLine);
+    });
+    it('does not silently collapse authored above and below into identical output', () => {
+        const below = xml.replace(/(<lyric\b[^>]*placement=)"above"/g, '$1"below"');
+        expect(render(xml).svg).not.toEqual(render(below).svg);
+    });
+    it('keeps native extender geometry in the authored above lane', () => {
+        const original = readFileSync('test-data/musicxml-lyrics/extenders.musicxml', 'utf8');
+        const above = original.replace(/<lyric\b/g, '<lyric placement="above"');
+        const result = render(above);
+        const ys = [...result.svg.matchAll(/<rect x="[^"]+" y="([^"]+)" width="[^"]+" height="0.75"/g)].map(m =>
+            Number(m[1])
+        );
+        expect(ys.length).toBeGreaterThan(2);
+        expect(Math.max(...ys)).toBeLessThan(result.topLine);
+    });
+    it('respects native lyric visibility for both placement lanes', () => {
+        const output = render(xml, true).svg;
+        expect(output).not.toContain('>I</text>');
+        expect(output).not.toContain('>be</text>');
+        expect(output).not.toContain('>lieve</text>');
+    });
+    it('keeps omitted placement identical to explicit default below', () => {
+        const below = xml.replace(/(<lyric\b[^>]*placement=)"above"/g, '$1"below"');
+        expect(render(below).svg).toEqual(render(below.replace(/ placement="below"/g, '')).svg);
+    });
+});
diff --git a/packages/alphatab/test/rendering/SharedNoteHeadSides.test.ts b/packages/alphatab/test/rendering/SharedNoteHeadSides.test.ts
new file mode 100644
index 0000000..70e3027
--- /dev/null
+++ b/packages/alphatab/test/rendering/SharedNoteHeadSides.test.ts
@@ -0,0 +1,69 @@
+import { MusicXmlImporter } from '@coderline/alphatab/importer/MusicXmlImporter';
+import { ByteBuffer } from '@coderline/alphatab/io/ByteBuffer';
+import { LayoutMode } from '@coderline/alphatab/LayoutMode';
+import { ScoreRenderer } from '@coderline/alphatab/rendering/ScoreRenderer';
+import { Settings } from '@coderline/alphatab/Settings';
+import { StaveProfile } from '@coderline/alphatab/StaveProfile';
+import { describe, expect, it } from 'vitest';
+
+const note = (pitch: string, duration: number, voice: number, stem: string) =>
+    `<note><pitch><step>${pitch}</step><octave>4</octave></pitch><duration>${duration}</duration><voice>${voice}</voice><type>${duration === 1 ? 'quarter' : 'half'}</type>${stem ? `<stem>${stem}</stem>` : ''}</note>`;
+function source(third = true, reverse = false) {
+    return `<score-partwise version="4.0"><part-list><score-part id="P"><part-name>Piano</part-name></score-part></part-list><part id="P"><measure number="1"><attributes><divisions>1</divisions><time><beats>2</beats><beat-type>4</beat-type></time><clef><sign>G</sign><line>2</line></clef></attributes>${note('G', 1, 1, reverse ? 'down' : 'up')}${note('G', 1, 1, reverse ? 'down' : 'up')}<backup><duration>2</duration></backup>${note('F', 2, 2, reverse ? 'up' : 'down')}${third ? `<backup><duration>2</duration></backup>${note('G', 2, 3, reverse ? 'up' : '')}` : ''}</measure></part></score-partwise>`;
+}
+function render(xml: string, horizontal = false) {
+    const settings = new Settings();
+    settings.core.engine = 'svg';
+    settings.core.enableLazyLoading = false;
+    settings.display.staveProfile = StaveProfile.Score;
+    if (horizontal) {
+        settings.display.layoutMode = LayoutMode.Horizontal;
+    }
+    const importer = new MusicXmlImporter();
+    importer.init(ByteBuffer.fromBuffer(new TextEncoder().encode(xml)), settings);
+    const score = importer.readScore(),
+        renderer = new ScoreRenderer(settings),
+        svg: string[] = [],
+        errors: unknown[] = [];
+    renderer.width = 800;
+    renderer.error.on(e => errors.push(e));
+    renderer.partialRenderFinished.on(e => {
+        if (typeof e.renderResult === 'string') {
+            svg.push(e.renderResult);
+        }
+    });
+    const original = score.tracks[0].staves[0].bars[0].voices.flatMap(v => v.beats.flatMap(b => b.notes));
+    expect(() => renderer.renderScore(score, [0])).not.toThrow();
+    renderer.destroy();
+    expect(errors).toEqual([]);
+    expect(svg.length).toBeGreaterThan(0);
+    expect(svg.join('')).not.toContain('NaN');
+    expect(original.length).toBeGreaterThanOrEqual(2);
+    return svg.join('');
+}
+describe('notehead sharing across correct and displaced group sides', () => {
+    for (const horizontal of [false, true]) {
+        for (const reverse of [false, true]) {
+            it(`renders displaced group extreme with ${reverse ? 'reversed' : 'normal'} stems in ${horizontal ? 'Horizontal' : 'Page'}`, () => {
+                render(source(true, reverse), horizontal);
+            });
+        }
+    }
+    it('preserves two-voice layout with no displaced third voice', () => {
+        render(source(false));
+    });
+});
+
+it('still aligns legal matching black heads on opposite stems', () => {
+    const xml = source(false)
+        .replaceAll('<duration>2</duration>', '<duration>1</duration>')
+        .replace('<beats>2</beats>', '<beats>1</beats>')
+        .replace(note('G', 1, 1, 'up') + note('G', 1, 1, 'up'), note('G', 1, 1, 'up'))
+        .replace(note('F', 2, 2, 'down'), note('G', 1, 2, 'down'));
+    const svg = render(xml);
+    const x = [...svg.matchAll(/<g transform="translate\(([^ ]+) ([^)]+)\)"[^>]*><text[^>]*>&#57508;<\/text>/g)].map(
+        m => Number(m[1])
+    );
+    expect(x.length).toBeGreaterThan(0);
+    expect(new Set(x).size).toBe(1);
+});
diff --git a/packages/alphatab/test/rendering/SourceDynamicsPlacement.test.ts b/packages/alphatab/test/rendering/SourceDynamicsPlacement.test.ts
new file mode 100644
index 0000000..679682b
--- /dev/null
+++ b/packages/alphatab/test/rendering/SourceDynamicsPlacement.test.ts
@@ -0,0 +1,97 @@
+import { MusicXmlImporter } from '@coderline/alphatab/importer/MusicXmlImporter';
+import { ByteBuffer } from '@coderline/alphatab/io/ByteBuffer';
+import { SourceDynamic } from '@coderline/alphatab/model/Bar';
+import { DynamicValue } from '@coderline/alphatab/model/DynamicValue';
+import { JsonConverter } from '@coderline/alphatab/model/JsonConverter';
+import { MusicFontSymbol } from '@coderline/alphatab/model/MusicFontSymbol';
+import { NotationElement } from '@coderline/alphatab/NotationSettings';
+import { ScoreRenderer } from '@coderline/alphatab/rendering/ScoreRenderer';
+import { Settings } from '@coderline/alphatab/Settings';
+import { StaveProfile } from '@coderline/alphatab/StaveProfile';
+import { describe, expect, it } from 'vitest';
+const xml =
+    '<score-partwise version="4.0"><part-list><score-part id="P1"><part-name>Piano</part-name></score-part></part-list><part id="P1"><measure number="1"><attributes><divisions>2</divisions><time><beats>4</beats><beat-type>4</beat-type></time><staves>2</staves><clef number="1"><sign>G</sign><line>2</line></clef><clef number="2"><sign>F</sign><line>4</line></clef></attributes><note><pitch><step>C</step><octave>5</octave></pitch><duration>8</duration><voice>1</voice><type>whole</type><staff>1</staff></note><backup><duration>8</duration></backup><note><pitch><step>C</step><octave>3</octave></pitch><duration>6</duration><voice>2</voice><type>half</type><dot/><staff>2</staff></note><note><pitch><step>D</step><octave>3</octave></pitch><duration>1</duration><voice>2</voice><type>eighth</type><staff>2</staff></note><note><pitch><step>E</step><octave>3</octave></pitch><duration>1</duration><voice>2</voice><type>eighth</type><staff>2</staff></note></measure></part></score-partwise>';
+function load() {
+    const settings = new Settings();
+    settings.core.engine = 'svg';
+    settings.core.enableLazyLoading = false;
+    settings.display.staveProfile = StaveProfile.Score;
+    const imp = new MusicXmlImporter();
+    imp.init(ByteBuffer.fromBuffer(new TextEncoder().encode(xml)), settings);
+    const score = imp.readScore();
+    score.stylesheet.hideDynamics = false;
+    score.tracks[0].staves[1].bars[0].sourceDynamics = [];
+    return { score, settings };
+}
+function declarations(above = true): SourceDynamic[] {
+    return [
+        Object.assign(new SourceDynamic(), { displayStart: 2880, value: DynamicValue.PP, placement: above ? 1 : 0 }),
+        Object.assign(new SourceDynamic(), { displayStart: 3360, value: DynamicValue.MP, placement: 0 })
+    ];
+}
+function render(marks = declarations(), hidden: 'stylesheet' | 'notation' | null = null) {
+    const { score, settings } = load();
+    score.tracks[0].staves[0].bars[0].sourceDynamics = marks;
+    if (hidden === 'stylesheet') { score.stylesheet.hideDynamics = true; }
+    if (hidden === 'notation') { settings.notation.elements.set(NotationElement.EffectDynamics, false); }
+    const r = new ScoreRenderer(settings),
+        svg: string[] = [];
+    r.width = 1000;
+    r.error.on(e => {
+        throw e;
+    });
+    r.partialRenderFinished.on(e => {
+        if (typeof e.renderResult === 'string') { svg.push(e.renderResult); }
+    });
+    r.renderScore(score, [0]);
+    return svg.join('');
+}
+function symbolY(svg: string, symbol: MusicFontSymbol) {
+    const matches = [
+        ...svg.matchAll(
+            new RegExp(`<g transform="translate\\([^ ]+ ([^)]+)\\)"[^>]*><text[^>]*>&#${symbol};<\\/text>`, 'g')
+        )
+    ];
+    expect(matches.length).toBe(1);
+    return Number(matches[0][1]);
+}
+describe('source dynamic above/below native lanes', () => {
+    it('retains explicit placement through Worker JSON', () => {
+        const { score } = load(),
+            bar = score.tracks[0].staves[0].bars[0];
+        bar.sourceDynamics = declarations();
+        const copy = JsonConverter.jsObjectToScore(JsonConverter.scoreToJsObject(score));
+        expect(copy.tracks[0].staves[0].bars[0].sourceDynamics).toEqual(bar.sourceDynamics);
+    });
+    it('places PP above RH and MP between staves with no RH beat at those times', () => {
+        const { score } = load();
+        expect(score.tracks[0].staves[0].bars[0].voices[0].beats.some(b => [2880, 3360].includes(b.displayStart))).toBe(
+            false
+        );
+        const svg = render(),
+            ys = [...svg.matchAll(/<rect x="[^"]+" y="([^"]+)" width="([^"]+)" height="([^"]+)"/g)]
+                .filter(m => Number(m[2]) > 50 && Number(m[3]) > 1 && Number(m[3]) < 2)
+                .map(m => Number(m[1])),
+            lines = [...new Set(ys)].sort((a, b) => a - b);
+        expect(lines.length).toBe(10);
+        expect(symbolY(svg, MusicFontSymbol.DynamicPP)).toBeLessThan(lines[0]);
+        expect(symbolY(svg, MusicFontSymbol.DynamicMP)).toBeGreaterThan(lines[4]);
+        expect(symbolY(svg, MusicFontSymbol.DynamicMP)).toBeLessThan(lines[5]);
+    });
+    it('does not collapse authored above into below output', () => {
+        expect(render()).not.toEqual(render(declarations(false)));
+    });
+    it.each(['stylesheet', 'notation'] as const)('respects %s hiding in both lanes', hidden => {
+        const svg = render(declarations(), hidden);
+        expect(svg).not.toContain(`&#${MusicFontSymbol.DynamicPP};`);
+        expect(svg).not.toContain(`&#${MusicFontSymbol.DynamicMP};`);
+    });
+    it('keeps omitted placement identical to explicit below', () => {
+        const omitted = declarations(false).map(d => {
+            const copy = { ...d };
+            delete copy.placement;
+            return copy;
+        });
+        expect(render(omitted)).toEqual(render(declarations(false)));
+    });
+});
diff --git a/packages/alphatab/test/rendering/SourceTexts.test.ts b/packages/alphatab/test/rendering/SourceTexts.test.ts
new file mode 100644
index 0000000..2012c27
--- /dev/null
+++ b/packages/alphatab/test/rendering/SourceTexts.test.ts
@@ -0,0 +1,84 @@
+import { MusicXmlImporter } from '@coderline/alphatab/importer/MusicXmlImporter';
+import { ByteBuffer } from '@coderline/alphatab/io/ByteBuffer';
+import { SourceText, SourceTextPlacement } from '@coderline/alphatab/model/Bar';
+import { JsonConverter } from '@coderline/alphatab/model/JsonConverter';
+import { NotationElement } from '@coderline/alphatab/NotationSettings';
+import { ScoreRenderer } from '@coderline/alphatab/rendering/ScoreRenderer';
+import { Settings } from '@coderline/alphatab/Settings';
+import { StaveProfile } from '@coderline/alphatab/StaveProfile';
+import { describe, expect, it } from 'vitest';
+
+const xml =
+    '<score-partwise><part-list><score-part id="P"><part-name>Voice</part-name></score-part></part-list><part id="P"><measure number="1"><attributes><divisions>1</divisions><time><beats>4</beats><beat-type>4</beat-type></time><clef><sign>G</sign><line>2</line></clef></attributes><note><pitch><step>C</step><octave>5</octave></pitch><duration>4</duration><type>whole</type></note></measure></part></score-partwise>';
+function load() {
+    const settings = new Settings();
+    settings.core.engine = 'svg';
+    settings.core.enableLazyLoading = false;
+    settings.display.staveProfile = StaveProfile.Score;
+    const importer = new MusicXmlImporter();
+    importer.init(ByteBuffer.fromBuffer(new TextEncoder().encode(xml)), settings);
+    return { settings, score: importer.readScore() };
+}
+function render(texts: SourceText[] | null, hidden = false) {
+    const { score, settings } = load();
+    const bar = score.tracks[0].staves[0].bars[0];
+    bar.sourceTexts = texts;
+    bar.voices[0].beats[0].text = 'LEGACY';
+    if (hidden) {
+        settings.notation.elements.set(NotationElement.EffectText, false);
+    }
+    const renderer = new ScoreRenderer(settings),
+        pieces: string[] = [];
+    renderer.width = 800;
+    renderer.error.on(x => {
+        throw x;
+    });
+    renderer.partialRenderFinished.on(x => {
+        if (typeof x.renderResult === 'string') {
+            pieces.push(x.renderResult);
+        }
+    });
+    renderer.renderScore(score, [0]);
+    renderer.destroy();
+    return pieces.join('');
+}
+const entry = (text: string, placement = SourceTextPlacement.Above, displayStart = 0) =>
+    Object.assign(new SourceText(), { text, placement, displayStart });
+describe('independent source word directions', () => {
+    it('preserves two same-time words in separate above and below bands', () => {
+        const svg = render([entry('LAUGH'), entry('SING', SourceTextPlacement.Below)]);
+        expect(svg).toContain('LAUGH');
+        expect(svg).toContain('SING');
+        expect(svg).not.toContain('LEGACY');
+        const y = (word: string) => Number(svg.match(new RegExp(`y="([^" ]+)"[^>]*>${word}</text>`))?.[1]);
+        expect(y('LAUGH')).toBeLessThan(y('SING'));
+    });
+    it('keeps multiple authored words on the same lane without overwriting', () => {
+        const svg = render([entry('FIRST'), entry('SECOND')]);
+        expect(svg).toContain('FIRST');
+        expect(svg).toContain('SECOND');
+    });
+    it('does not quantize offbeat text to an attack', () => {
+        const svg = render([
+            entry('FIRST', SourceTextPlacement.Above, 480),
+            entry('SECOND', SourceTextPlacement.Above, 2400)
+        ]);
+        expect(svg).toContain('FIRST');
+        expect(svg).toContain('SECOND');
+    });
+    it('keeps legacy null and explicit empty declaration semantics', () => {
+        expect(render(null)).toContain('LEGACY');
+        expect(render([])).not.toContain('LEGACY');
+    });
+    it('honors notation hiding and rejects invalid display coordinates', () => {
+        expect(render([entry('HIDDEN')], true)).not.toContain('HIDDEN');
+        expect(render([entry('BAD', SourceTextPlacement.Above, Number.NaN)])).not.toContain('BAD');
+        expect(render([entry('BAD', SourceTextPlacement.Above, 4000)])).not.toContain('BAD');
+    });
+    it('roundtrips placement/time/literal words through the Worker JSON model', () => {
+        const { score, settings } = load();
+        score.tracks[0].staves[0].bars[0].sourceTexts = [entry('LAUGH\nGROUP', SourceTextPlacement.Below, 480.5)];
+        const restored = JsonConverter.jsObjectToScore(JsonConverter.scoreToJsObject(score), settings);
+        expect(restored.tracks[0].staves[0].bars[0].sourceTexts).toEqual(score.tracks[0].staves[0].bars[0].sourceTexts);
+    });
+});
