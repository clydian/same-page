+import { LyricElement } from "@coderline/alphatab/model/LyricElement";
+/**
+ * @internal
+ */
+export class LyricElementCloner {
+    public static clone(original: LyricElement): LyricElement {
+        const clone = new LyricElement();
+        clone.placement = original.placement;
+        clone.syllabic = original.syllabic;
+        clone.extension = original.extension;
+        return clone;
+    }
+}
